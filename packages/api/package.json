{
  "name": "@filigree/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@filigree/alg-force": "workspace:*",
    "@filigree/alg-layered": "workspace:*",
    "@filigree/alg-mrtree": "workspace:*",
    "@filigree/alg-radial": "workspace:*",
    "@filigree/core": "workspace:*",
    "@filigree/graph": "workspace:*",
    "@filigree/render-svg": "workspace:*"
  },
  "devDependencies": {
    "@filigree/hints": "workspace:*"
  }
}
