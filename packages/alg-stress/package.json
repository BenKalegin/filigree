{
  "name": "@filigree/alg-stress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@filigree/core": "workspace:*",
    "@filigree/graph": "workspace:*"
  },
  "devDependencies": {},
  "description": "Stress-majorization graph layout for filigree.",
  "license": "EPL-2.0",
  "author": "Ben Kalegin",
  "homepage": "https://github.com/BenKalegin/filigree#readme",
  "bugs": "https://github.com/BenKalegin/filigree/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/BenKalegin/filigree.git",
    "directory": "packages/alg-stress"
  },
  "keywords": [
    "graph-layout",
    "elk",
    "layout",
    "typescript",
    "diagram",
    "stress-majorization"
  ]
}
