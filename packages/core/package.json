{
  "name": "@benkalegin/filigree-core",
  "version": "0.1.5",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@benkalegin/filigree-graph": "workspace:*"
  },
  "description": "Layout engine, algorithm registry, option resolver, and observer dispatch for filigree.",
  "license": "EPL-2.0",
  "author": "Ben Kalegin",
  "homepage": "https://github.com/BenKalegin/filigree#readme",
  "bugs": "https://github.com/BenKalegin/filigree/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/BenKalegin/filigree.git",
    "directory": "packages/core"
  },
  "keywords": [
    "graph-layout",
    "elk",
    "layout",
    "typescript",
    "diagram"
  ]
}
